digraph G {
  rankdir=LR; nodesep=0.2; ranksep=0.25;
  node [shape=box, style="rounded,filled", fillcolor="#fde7ef", color="#8a3b5c", fontname="Times-Roman", fontsize=11, margin="0.1,0.05"];
